#!/usr/bin/env bash
#
# sandbox — a disposable Hermes home for developing this plugin.
#
# A contributor may already have `HERMES_HOME` pointed at a real deployment.
# Every command here overrides both `HERMES_HOME` and `HERMES_KANBAN_HOME`
# explicitly, and refuses to run if the result is not inside this repo.
#
# A Hermes home is a directory and two variables. There is nothing to install:
# `hermes kanban` bootstraps an empty directory into a working board on first
# use, with no profile, no config and no gateway.
#
#   sandbox test       run the unit suite through uv, pinned to Python 3.13
#                      (Hermes requires <3.14: test what runs).
#   sandbox lint       ruff check + ruff format --check, per pyproject.toml.
#   sandbox up         create the sandbox home and show what it is
#   sandbox env        print the exports, for `eval "$(scripts/sandbox env)"`
#   sandbox task       create a task and walk it through a realistic lifecycle
#   sandbox dispatch   one real dispatcher pass, spawning nothing
#   sandbox events     dump task_events — this is what the plugin consumes
#   sandbox consume    run the consumer against the sandbox board, printing
#                      instead of publishing; state persists in the sandbox
#   sandbox reconcile  operator verbs over the sandbox plugin-state DB
#   sandbox doctor     load this plugin through the real runtime, offline
#   sandbox reset      send the sandbox home to the trash and start over
#
# Nothing here writes outside `.sandbox/`, which is git-ignored.

set -euo pipefail

PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SANDBOX="$REPO/.sandbox"

# The guard checks the sandbox path the script is about to use, not an inherited
# HERMES_HOME that may point elsewhere.
assert_sandboxed() {
    case "$SANDBOX" in
        "$REPO"/*) ;;
        *) printf 'sandbox: refusing — %s is not inside %s\n' "$SANDBOX" "$REPO" >&2; exit 1 ;;
    esac
    if [ -e "$SANDBOX/.git" ] || [ -e "$SANDBOX/profiles" ] && [ ! -e "$SANDBOX/.is-sandbox" ]; then
        printf 'sandbox: refusing — %s looks like a real Hermes home\n' "$SANDBOX" >&2
        exit 1
    fi
}

sandbox_env() {
    assert_sandboxed
    export HERMES_HOME="$SANDBOX"
    export HERMES_KANBAN_HOME="$SANDBOX"
    # 1Password resolves through a service account or not at all. Without these a
    # missing token can send `op` to the desktop app, once per reference — and the
    # sandbox has no secrets to resolve anyway.
    export OP_LOAD_DESKTOP_APP_SETTINGS=false OP_BIOMETRIC_UNLOCK_ENABLED=false
}

board_db() {
    # A fresh home uses the single-file layout until boards are created.
    if [ -f "$SANDBOX/kanban.db" ]; then
        printf '%s' "$SANDBOX/kanban.db"
    else
        find "$SANDBOX/kanban/boards" -name '*.db' -maxdepth 2 2>/dev/null | head -1
    fi
}

cmd_up() {
    assert_sandboxed
    mkdir -p "$SANDBOX"
    : > "$SANDBOX/.is-sandbox"
    sandbox_env
    hermes kanban boards list >/dev/null 2>&1 || true
    printf 'sandbox home: %s\n' "$SANDBOX"
    printf 'inherited home (untouched): %s\n' "${HERMES_HOME_INHERITED:-$(zsh -c 'echo $HERMES_HOME' 2>/dev/null || echo '?')}"
    printf '\n'
    hermes kanban boards list
}

cmd_env() {
    assert_sandboxed
    printf 'export HERMES_HOME=%q\n' "$SANDBOX"
    printf 'export HERMES_KANBAN_HOME=%q\n' "$SANDBOX"
    printf 'export OP_LOAD_DESKTOP_APP_SETTINGS=false OP_BIOMETRIC_UNLOCK_ENABLED=false\n'
}

cmd_task() {
    sandbox_env
    local title="${1:-sandbox task}"
    local id
    id="$(hermes kanban create "$title" --assignee sandbox 2>&1 | sed -n 's/^Created \([a-z_0-9]*\).*/\1/p')"
    [ -n "$id" ] || { printf 'sandbox: could not create a task\n' >&2; exit 1; }
    printf 'created %s\n' "$id"

    # A lifecycle the plugin has to render: a comment, a human-facing block, its
    # release, and completion. None of it needs an agent, because each verb
    # writes a real row into task_events.
    hermes kanban comment "$id" "a human note" >/dev/null
    hermes kanban block "$id" --kind needs_input "waiting on a decision" >/dev/null
    hermes kanban unblock "$id" >/dev/null
    # --summary, not a positional: `complete` takes task ids positionally, so a
    # bare message is read as a second task id and fails on it.
    hermes kanban complete "$id" --summary "walked by the sandbox" >/dev/null
    printf 'walked %s through comment -> blocked -> unblocked -> completed\n' "$id"
}

cmd_dispatch() {
    sandbox_env
    # A real dispatcher pass with no gateway. --dry-run spawns nothing, and the
    # JSON is the same DispatchResult a plugin hook receives.
    hermes kanban dispatch --dry-run --json
}

cmd_events() {
    sandbox_env
    local db; db="$(board_db)"
    [ -n "$db" ] && [ -f "$db" ] || { printf 'sandbox: no board yet — run `sandbox up` then `sandbox task`\n' >&2; exit 1; }
    python3 - "$db" <<'PY'
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
rows = list(conn.execute("SELECT id, task_id, kind FROM task_events ORDER BY id"))
if not rows:
    print("no events yet")
else:
    print(f"{'id':>4}  {'task':<12} kind")
    for eid, task, kind in rows:
        print(f"{eid:>4}  {task:<12} {kind}")
PY
}

cmd_consume() {
    sandbox_env
    local db; db="$(board_db)"
    [ -n "$db" ] && [ -f "$db" ] || { printf 'sandbox: no board yet — run `sandbox up` then `sandbox task`\n' >&2; exit 1; }
    python3 "$REPO/scripts/consume_sandbox.py" "$db" "$SANDBOX/plugin-state.db"
}

cmd_reconcile() {
    # Operator verbs over the sandbox's plugin state DB (attention/clear/
    # adopt/rearm/recreate). Never touches Discord.
    assert_sandboxed
    python3 "$REPO/scripts/reconcile.py" "$SANDBOX/plugin-state.db" "$@"
}

cmd_doctor() {
    sandbox_env
    # Loads the plugin through the real runtime in its own temporary home with
    # sockets blocked, so nothing can reach Discord.
    hermes plugins doctor "$REPO"
}

cmd_test() {
    # No Hermes, no network, no sandbox home involved: the suite is pure
    # stdlib + pytest, provisioned consistently through uv.
    command -v uv >/dev/null 2>&1 || {
        printf 'sandbox: uv not found — install it before running the suite.\n' >&2
        exit 1
    }
    cd "$REPO"
    # --python 3.13: the plugin runs under Hermes's interpreter (<3.14); the
    # suite must run on what production runs, not on whatever brew has today.
    exec uv run --python 3.13 --with pytest==9.1.1 -- python -m pytest tests/ "$@"
}

cmd_lint() {
    # Upstream Hermes has no formatter directive, which binds us to nothing:
    # within this repo, ruff format buys consistency and quiet diffs. The
    # conventions we DO mirror from Hermes live in pyproject.toml.
    command -v uv >/dev/null 2>&1 || { printf 'sandbox: uv not found\n' >&2; exit 1; }
    cd "$REPO"
    uvx --from ruff==0.16.8 ruff check .
    uvx --from ruff==0.16.8 ruff format --check .
}

cmd_reset() {
    assert_sandboxed
    [ -d "$SANDBOX" ] || { printf 'nothing to reset\n'; return 0; }
    if command -v trash >/dev/null 2>&1; then
        trash "$SANDBOX"
        printf 'sandbox sent to the trash — recoverable\n'
    else
        printf 'sandbox: `trash` not found. Remove %s by hand rather than\n' "$SANDBOX" >&2
        printf 'having this script run rm -rf on a path it computed.\n' >&2
        exit 1
    fi
}

case "${1:-}" in
    test)     shift; cmd_test "$@" ;;
    lint)     cmd_lint ;;
    up)       cmd_up ;;
    env)      cmd_env ;;
    task)     shift; cmd_task "$@" ;;
    dispatch) cmd_dispatch ;;
    events)   cmd_events ;;
    consume)  cmd_consume ;;
    reconcile) shift; cmd_reconcile "$@" ;;
    doctor)   cmd_doctor ;;
    reset)    cmd_reset ;;
    *)        sed -n '3,33p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
